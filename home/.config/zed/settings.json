{
        "agent_buffer_font_family": "MartianMono Nerd Font Mono",
        "bottom_dock_layout": "contained",
        "ui_font_family": ".SystemUIFont",
        "show_wrap_guides": true,
        "diagnostics": {
                "button": true,
        },
        "collaboration_panel": {
                "dock": "left",
        },
        "agent": {
                "dock": "right",
                "favorite_models": [],
                "model_parameters": [],
        },
        "git_panel": {
                "dock": "left",
        },
        "tab_bar": {
                "show_pinned_tabs_in_separate_row": false,
                "show_tab_bar_buttons": true,
                "show_nav_history_buttons": false,
        },
        "title_bar": {
                "show_branch_name": true,
                "show_branch_status_icon": true,
                "show_menus": false,
        },
        "active_pane_modifiers": {
                "border_size": 0.0,
        },
        "use_system_window_tabs": true,
        "tabs": {
                "git_status": false,
                "close_position": "right",
        },
        "telemetry": {
                "diagnostics": false,
                "metrics": false,
        },
        "indent_guides": {
                "line_width": 1,
        },
        "hard_tabs": false,
        "tab_size": 8,
        "vim": {
                "toggle_relative_line_numbers": false,
        },
        "toolbar": {
                "agent_review": true,
                "selections_menu": true,
                "quick_actions": true,
                "breadcrumbs": true,
        },
        "minimap": {
                "current_line_highlight": "all",
        },
        "scrollbar": {
                "show": "auto",
        },
        "gutter": {
                "breakpoints": true,
                "runnables": true,
        },
        "expand_excerpt_lines": 5,
        "search": {
                "button": true,
        },
        "status_bar": {
                "show_active_file": false,
                "cursor_position_button": true,
                "active_language_button": true,
        },
        "outline_panel": {
                "dock": "left",
                "button": true,
        },
        "terminal": {
                "scrollbar": {
                        "show": "never",
                },
                "toolbar": {
                        "breadcrumbs": false,
                },
                "minimum_contrast": 45.0,
                "cursor_shape": "bar",
                "font_weight": 400.0,
                "font_size": 12.0,
                "button": true,
                "show_count_badge": false,
                "dock": "bottom",
        },
        "project_panel": {
                "folder_indicator": "icon",
                "default_width": 220.0,
                "button": true,
                "hide_hidden": false,
                "hide_root": false,
                "sticky_scroll": true,
                "git_status_indicator": false,
                "diagnostic_badges": false,
                "show_diagnostics": "all",
                "scrollbar": {
                        "horizontal_scroll": true,
                        "show": "never",
                },
                "bold_folder_labels": false,
                "auto_fold_dirs": true,
                "starts_open": true,
                "auto_reveal_entries": true,
                "git_status": true,
                "file_icons": true,
                "dock": "left",
        },
        "minimum_contrast_for_highlights": 0.0,
        "unnecessary_code_fade": 0.3,
        "text_rendering_mode": "platform_default",
        "agent_buffer_font_size": 12.0,
        "agent_ui_font_size": 13.0,
        "ui_font_weight": 350.0,
        "ui_font_size": 15.0,
        "buffer_font_family": "IoskeleyMono Nerd Font",
        "buffer_line_height": "comfortable",
        "buffer_font_weight": 300.0,
        "buffer_font_size": 15.0,
        "icon_theme": {
                "mode": "system",
                "light": "Base Charmed Icons",
                "dark": "Base Charmed Icons"
        },
        "theme": "Catppuccin Macchiato (Blur)",
}
